pipeline {
    agent {
        docker {
            image 'python:3.14-slim'
        }
    }

    environment {
        PYTHONUNBUFFERED = '1'
        PIP_NO_CACHE_DIR = '1'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout()  // Optional: prevents automatic checkout at start
    }

    parameters {
        choice(
            name: 'KAFKA_ENV',
            choices: ['Test', 'Uat', 'Prod', 'ALL'],
            description: 'Kafka Environment'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                dir('kafka-automation') {
                    checkout scmGit(
                        branches: [[name: "origin/main"]],
                        extensions: [
                            [$class: 'CloneOption', 
                             quiet: true,
                             depth: 1,
                             noTags: true,
                             timeout: 10]
                        ],
                        userRemoteConfigs: [[
                            url: 'https://github.com/anjon/kafka-automation.git'
                        ]]
                    )
                }
            }
        }

        stage('Checking Repo') {
            steps {
                dir('kafka-automation') {
                    sh '''
                        python --version
                        ls -l
                    '''
                }
            }
        }

        stage('Test Environment') {
            when {
                expression { params.KAFKA_ENV in ['Test', 'ALL'] }
            }
            steps {
                script {
                    echo "Running for ${params.KAFKA_ENV} environment"
                }
            }
        }

        stage('UAT Environment') {
            when {
                expression { params.KAFKA_ENV in ['Uat', 'ALL'] }
            }
            steps {
                script {
                    echo "Running for ${params.KAFKA_ENV} environment"
                }
            }
        }

        stage('Prod Environment') {
            when {
                expression { params.KAFKA_ENV in ['Prod', 'ALL'] }
            }
            steps {
                script {
                    echo "Running for ${params.KAFKA_ENV} environment"
                }
            }
        }
    }
}